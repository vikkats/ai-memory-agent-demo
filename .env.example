# Copy to .env.local for local experiments. Never commit real secrets.

# --- Model provider (OpenAI-compatible) ---
# Leave unset to run the deterministic offline mock model.
AGENT_PROVIDER_NAME=
AGENT_PROVIDER_BASE_URL=
AGENT_PROVIDER_API_KEY=
AGENT_PROVIDER_MODEL_ID=

# --- Embeddings (optional; falls back to deterministic local embeddings) ---
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL_ID=

# --- Qdrant (optional; falls back to the local JSON vector store) ---
AGENT_QDRANT_URL=
AGENT_QDRANT_API_KEY=
AGENT_QDRANT_COLLECTION=agent_memories

# --- Runtime ---
AGENT_DATA_DIR=./data
AGENT_SQLITE_BUSY_TIMEOUT_MS=5000
AGENT_WATCHER_INTERVAL_SECONDS=60

# --- Maintenance cycle (nightly-style memory consolidation) ---
AGENT_MAINTENANCE_ENABLED=false
AGENT_MAINTENANCE_INTERVAL_MINUTES=360
AGENT_MAINTENANCE_REQUIRE_NEW_MESSAGES=true
AGENT_MAINTENANCE_UPDATE_LIVE_STATE=true
AGENT_MAINTENANCE_WRITE_JOURNAL=true
AGENT_MAINTENANCE_SUMMARIZE=false
AGENT_MAINTENANCE_AUTO_INDEX=true
